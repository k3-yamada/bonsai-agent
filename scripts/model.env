# bonsai-agent モデル設定の single source of truth (shell 側)。
# Rust 側の source of truth は src/domain/model_profile.rs。preset の内容はそちらの
# ModelProfile レジストリと 1:1 対応させてある。
#
# 全ての値は env で上書き可能。優先順位は「呼び出し時の env > BONSAI_MODEL_ID に応じた
# preset > (未知 ID の場合の) フォールバック既定値」。
#
# Usage: 各 scripts/*.sh の先頭で `. "$(dirname "$0")/model.env"` として source する。
# BONSAI_MODEL_ID だけを変えれば、GGUF/MLX repo、context 長、推論パラメータ、保存先が
# まとめて切り替わる（例: `BONSAI_MODEL_ID=bonsai-8b ./scripts/start-server.sh`）。

: "${BONSAI_MODEL_ID:=minicpm5-2b}"

case "$BONSAI_MODEL_ID" in
    minicpm5-2b)
        _gguf_repo="openbmb/MiniCPM5-2B-GGUF"
        _gguf_file="MiniCPM5-2B-Q4_K_M.gguf"
        _mlx_repo="openbmb/MiniCPM5-2B-MLX"
        _ctx=32768
        _dir="$HOME/.cache/bonsai-agent/models"
        _temp=0.6
        _top_p=0.95
        _rep=1.05
        ;;
    minicpm5-1b)
        # gguf_file はファイル名推定 (openbmb/MiniCPM5-1B-GGUF は要確認)。
        _gguf_repo="openbmb/MiniCPM5-1B-GGUF"
        _gguf_file="MiniCPM5-1B-Q4_K_M.gguf"
        _mlx_repo="openbmb/MiniCPM5-1B-MLX"
        _ctx=32768
        _dir="$HOME/.cache/bonsai-agent/models"
        _temp=0.6
        _top_p=0.95
        _rep=1.05
        ;;
    bonsai-8b)
        # legacy: 1-bit 量子化 Qwen3-8B。Bonsai-demo 同梱の llama-server fork が必要。
        _gguf_repo="prism-ml/Bonsai-8B-gguf"
        _gguf_file="Bonsai-8B.gguf"
        _mlx_repo=""
        _ctx=16384
        _dir="$HOME/Bonsai-demo/models/gguf/8B"
        _temp=0.5
        _top_p=0.85
        _rep=1.15
        ;;
    ternary-bonsai-8b)
        # legacy: PrismML MLX fork が必要。
        _gguf_repo="prism-ml/Ternary-Bonsai-8B-GGUF"
        _gguf_file="Ternary-Bonsai-8B.gguf"
        _mlx_repo="prism-ml/Ternary-Bonsai-8B-mlx-2bit"
        _ctx=65536
        _dir="$HOME/Bonsai-demo/models/gguf/8B"
        _temp=0.3
        _top_p=0.9
        _rep=1.1
        ;;
    *)
        echo "警告: 未知の BONSAI_MODEL_ID=$BONSAI_MODEL_ID。BONSAI_MODEL_GGUF_REPO 等を全て明示してください" >&2
        _gguf_repo=""
        _gguf_file=""
        _mlx_repo=""
        _ctx=32768
        _dir="$HOME/.cache/bonsai-agent/models"
        _temp=0.6
        _top_p=0.95
        _rep=1.05
        ;;
esac

: "${BONSAI_MODEL_GGUF_REPO:=$_gguf_repo}"
: "${BONSAI_MODEL_GGUF_FILE:=$_gguf_file}"
: "${BONSAI_MODEL_MLX_REPO:=$_mlx_repo}"
: "${BONSAI_MODEL_CTX:=$_ctx}"
: "${BONSAI_MODEL_DIR:=$_dir}"
: "${BONSAI_MODEL_TEMP:=$_temp}"
: "${BONSAI_MODEL_TOP_P:=$_top_p}"
: "${BONSAI_MODEL_REPEAT_PENALTY:=$_rep}"
: "${BONSAI_ENABLE_THINKING:=false}"
# llama-server: PATH 上の llama-server (brew install llama.cpp) → Bonsai-demo 同梱 fork の順で探す
: "${BONSAI_LLAMA_SERVER_BIN:=$(command -v llama-server 2>/dev/null || echo "$HOME/Bonsai-demo/bin/mac/llama-server")}"

unset _gguf_repo _gguf_file _mlx_repo _ctx _dir _temp _top_p _rep
