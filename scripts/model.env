# bonsai-agent モデル設定の single source of truth (shell 側)。
# Rust 側の source of truth は src/domain/model_profile.rs。preset の内容はそちらの
# ModelProfile レジストリと 1:1 対応させてある。
#
# 全ての値は env で上書き可能。優先順位は「呼び出し時の env > BONSAI_MODEL_ID に応じた
# preset > (未知 ID の場合の) フォールバック既定値」。
#
# Usage: 各 scripts/*.sh の先頭で `. "$(dirname "$0")/model.env"` として source する。
# BONSAI_MODEL_ID だけを変えれば、GGUF/MLX repo、context 長、推論パラメータ、保存先が
# まとめて切り替わる（例: `BONSAI_MODEL_ID=bonsai-8b ./scripts/start-server.sh`）。
#
# `BONSAI_MODEL` は Rust 側 (`resolve_model_id()`) が読む env。shell 側と Rust 側の両方に
# 値を渡したい場合、両方を設定すれば shell 側は `BONSAI_MODEL_ID` を優先し、Rust 側は
# `BONSAI_MODEL` を優先する（優先順位は互いに独立）。`BONSAI_MODEL_ID` 未設定時に限り
# `BONSAI_MODEL` をフォールバックとして採用するが、値が既知 preset id
# (`minicpm5-2b` / `minicpm5-1b` / `bonsai-8b` / `ternary-bonsai-8b`) と一致する場合のみ有効で、
# 一致しない自由文字列（HF repo id 等）は無視して既定 `minicpm5-2b` を使い、警告を出す。
# `BONSAI_MODEL` と `BONSAI_MODEL_ID` を両方設定していて値が食い違う場合も、
# Rust 側と shell 側で別モデルになる旨の警告を別途出す。

# BONSAI_MODEL_ID が呼び出し時点で明示設定済みかどうかを、値の中身を見る前に記録しておく
# (${VAR+1} は「設定されているか」だけを問う POSIX 標準の構文で、空文字設定とも区別できる)。
_bonsai_model_id_was_set=${BONSAI_MODEL_ID+1}
_bonsai_model_snapshot=${BONSAI_MODEL:-}

if [ -z "$_bonsai_model_id_was_set" ]; then
    case "$_bonsai_model_snapshot" in
        minicpm5-2b | minicpm5-1b | bonsai-8b | ternary-bonsai-8b)
            BONSAI_MODEL_ID="$_bonsai_model_snapshot"
            ;;
        "")
            BONSAI_MODEL_ID="minicpm5-2b"
            ;;
        *)
            echo "BONSAI_MODEL=$_bonsai_model_snapshot は preset id ではないため shell 側では無視 (BONSAI_MODEL_ID を明示してください)" >&2
            BONSAI_MODEL_ID="minicpm5-2b"
            ;;
    esac
fi

if [ -n "$_bonsai_model_id_was_set" ] && [ -n "$_bonsai_model_snapshot" ] && [ "$_bonsai_model_snapshot" != "$BONSAI_MODEL_ID" ]; then
    echo "警告: BONSAI_MODEL=$_bonsai_model_snapshot と BONSAI_MODEL_ID=$BONSAI_MODEL_ID が異なります。Rust 側は BONSAI_MODEL、shell 側は BONSAI_MODEL_ID を使うため、agent と server で別モデルになります" >&2
fi

unset _bonsai_model_id_was_set _bonsai_model_snapshot

case "$BONSAI_MODEL_ID" in
    minicpm5-2b)
        # M2 16GB 向け保守的既定。KV q8_0 で ≈21.5 KB/token (16k ≈ 0.35 GB)。
        # 32k 以上に増やす場合は BONSAI_MODEL_CTX で opt-in する。
        _gguf_repo="openbmb/MiniCPM5-2B-GGUF"
        _gguf_file="MiniCPM5-2B-Q4_K_M.gguf"
        _mlx_repo="openbmb/MiniCPM5-2B-MLX"
        _ctx=16384
        _dir="$HOME/.cache/bonsai-agent/models"
        _temp=0.6
        _top_p=0.95
        _rep=1.05
        ;;
    minicpm5-1b)
        # HF 確認済 2026-09-09 (Q4_K_M 688MB)。推奨値は 2B と同じ初期値で未検証。
        # M2 16GB 向け保守的既定。32k 以上は BONSAI_MODEL_CTX で opt-in する。
        _gguf_repo="openbmb/MiniCPM5-1B-GGUF"
        _gguf_file="MiniCPM5-1B-Q4_K_M.gguf"
        _mlx_repo="openbmb/MiniCPM5-1B-MLX"
        _ctx=16384
        _dir="$HOME/.cache/bonsai-agent/models"
        _temp=0.6
        _top_p=0.95
        _rep=1.05
        ;;
    bonsai-8b)
        # legacy: 1-bit 量子化 Qwen3-8B。Bonsai-demo 同梱の llama-server fork が必要。
        _gguf_repo="prism-ml/Bonsai-8B-gguf"
        _gguf_file="Bonsai-8B.gguf"
        _mlx_repo=""
        _ctx=16384
        _dir="$HOME/Bonsai-demo/models/gguf/8B"
        _temp=0.5
        _top_p=0.85
        _rep=1.15
        ;;
    ternary-bonsai-8b)
        # legacy: PrismML MLX fork が必要。
        _gguf_repo="prism-ml/Ternary-Bonsai-8B-GGUF"
        _gguf_file="Ternary-Bonsai-8B.gguf"
        _mlx_repo="prism-ml/Ternary-Bonsai-8B-mlx-2bit"
        _ctx=65536
        _dir="$HOME/Bonsai-demo/models/gguf/8B"
        _temp=0.3
        _top_p=0.9
        _rep=1.1
        ;;
    *)
        echo "警告: 未知の BONSAI_MODEL_ID=$BONSAI_MODEL_ID。BONSAI_MODEL_GGUF_REPO 等を全て明示してください" >&2
        # M2 16GB 向け保守的既定 (minicpm5-2b と同じ)。32k 以上は BONSAI_MODEL_CTX で opt-in する。
        _gguf_repo=""
        _gguf_file=""
        _mlx_repo=""
        _ctx=16384
        _dir="$HOME/.cache/bonsai-agent/models"
        _temp=0.6
        _top_p=0.95
        _rep=1.05
        ;;
esac

: "${BONSAI_MODEL_GGUF_REPO:=$_gguf_repo}"
: "${BONSAI_MODEL_GGUF_FILE:=$_gguf_file}"
: "${BONSAI_MODEL_MLX_REPO:=$_mlx_repo}"
: "${BONSAI_MODEL_CTX:=$_ctx}"
: "${BONSAI_MODEL_DIR:=$_dir}"
: "${BONSAI_MODEL_TEMP:=$_temp}"
: "${BONSAI_MODEL_TOP_P:=$_top_p}"
: "${BONSAI_MODEL_REPEAT_PENALTY:=$_rep}"
: "${BONSAI_ENABLE_THINKING:=false}"
# llama-server: PATH 上の llama-server (brew install llama.cpp) → Bonsai-demo 同梱 fork の順で探す
: "${BONSAI_LLAMA_SERVER_BIN:=$(command -v llama-server 2>/dev/null || echo "$HOME/Bonsai-demo/bin/mac/llama-server")}"

unset _gguf_repo _gguf_file _mlx_repo _ctx _dir _temp _top_p _rep
