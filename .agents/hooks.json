{
  "bonsai-safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/check-release-build-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "bonsai-post-edit-checker": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/check-clippy-rewind-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "bonsai-stop-ratchet": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "./hooks/verify-stop-ratchet.sh",
        "timeout": 10
      }
    ]
  }
}
